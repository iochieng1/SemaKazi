{
  "name": "semakazi-backend",
  "version": "1.0.0",
  "description": "Verified skills & reputation platform for Kenya's informal-sector workers (fundis)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/db/seed.js",
    "db:backup": "node src/db/backupCli.js backup",
    "db:backups": "node src/db/backupCli.js list",
    "db:restore": "node src/db/backupCli.js restore",
    "db:verify-backup": "node src/db/backupCli.js verify",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  }
}
