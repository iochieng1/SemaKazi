# Copy this file to .env and replace values before starting the backend.

# JWT secret for signing auth tokens. Keep this private. Required in production.
JWT_SECRET=your-long-random-secret

# Shared secret for review moderation (x-admin-token header). Required in
# production, at least 32 characters: openssl rand -hex 32
ADMIN_TOKEN=your-long-random-admin-token

# Local/demo only: seed sample accounts on startup if the database is empty.
# Ignored when NODE_ENV=production.
SEED_DEMO_DATA=false

# Optional: token expiration window.
JWT_EXPIRES_IN=7d

# Optional: backend server port.
PORT=4000

# Optional: SQLite database path; set an absolute path in production.
DB_PATH=./data/semakazi.db

# Off-disk backups to S3-compatible storage. Required before launch; see
# docs/DATABASE_BACKUPS.md. BACKUP_DIR=./backups stores them locally instead,
# for testing only.
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_INTERVAL_HOURS=6
